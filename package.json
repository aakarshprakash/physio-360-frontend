{
  "name": "physio360-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:clinic": "pnpm --filter @physio/clinic dev",
    "dev:console": "pnpm --filter @physio/console dev",
    "dev:patient": "pnpm --filter @physio/patient dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . && node scripts/check-logical-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gen:api": "pnpm --filter @physio/api gen"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.7"
  }
}
